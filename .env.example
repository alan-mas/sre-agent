# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- LangSmith (Developer plan, free) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sre-k8s-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Budget guard (local hard cap on Claude spend; ledger in .budget/) ---
# Monthly cap (each UTC calendar month gets its own ledger)
BUDGET_USD=15
BUDGET_WARN_RATIO=0.8

# --- Models (D3) ---
IC_MODEL=claude-sonnet-5-5  # D27: same accuracy as Opus at ~40% of the cost
IC_EFFORT=medium
SUBAGENT_MODEL=claude-haiku-5-5
SUBAGENT_EFFORT=low

# --- Kubernetes (`make cluster-up` generates these files; never commit them) ---
AGENT_KUBECONFIG=./infra/rbac/generated/kubeconfig-agent-readonly
AGENT_OPERATOR_KUBECONFIG=./infra/rbac/generated/kubeconfig-agent-operator  # write identity, 8h token
AGENT_NAMESPACE_ALLOWLIST=demo,kube-system
TOOL_MAX_CHARS=4000

# --- Slack on-call approvals (optional; infra/slack/manifest.yaml) ---
# SLACK_BOT_TOKEN=xoxb-...      # OAuth & Permissions → Bot User OAuth Token
# SLACK_APP_TOKEN=xapp-...      # Basic Information → App-Level Token with connections:write (Socket Mode)
# SLACK_CHANNEL=C0123456789     # channel ID of the alerts channel (invite the bot: /invite @sre-agent)
# SLACK_APPROVERS=U0123,U0456   # Slack user IDs allowed to approve; empty = anyone in the channel

# --- LangGraph dev server ---
# macOS truststore rejects minikube's self-signed API cert; `make dev` sets this for you.
# DISABLE_TRUSTSTORE=true

# Knowledge base (make kb-up): local pgvector, trust auth on 127.0.0.1 only, so no password.
# KB_DSN=postgresql://sre@127.0.0.1:5433/kb
